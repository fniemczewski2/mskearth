# Supabase. URL i klucz publishable trafiaja do przegladarki (envPrefix w vite.config.js),
# klucz secret zostaje na serwerze (api/). Starsze nazwy VITE_SUPABASE_URL,
# VITE_SUPABASE_ANON_KEY i SUPABASE_SERVICE_KEY nadal dzialaja.
SUPABASE_URL=https://twoj-projekt.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
VITE_AUTH_CALLBACK_URL=
# Google Analytics 4 (G-XXXXXXXXXX). Puste = analityka wylaczona, baner cookies jest sama informacja.
VITE_GA_MEASUREMENT_ID=
# Cloudflare Turnstile: klucz witryny (publiczny). Pusty = formularze nie pobieraja tokenu.
VITE_TURNSTILE_SITE_KEY=
# Link logowania do portalu klienta Stripe na stronie /subskrypcja (https://billing.stripe.com/p/login/...).
# Pusty = strona pokazuje adres e-mail fundacji.
VITE_STRIPE_PORTAL_LOGIN_URL=

SITE_URL=https://msk.earth

STRIPE_SECRET_KEY=
# Opcjonalne: konfiguracja portalu klienta Stripe (bpc_...); puste = domyslna.
STRIPE_PORTAL_CONFIGURATION_ID=

# Newsletter: GetResponse API v3. LIST_ID to token listy (np. "aBc1D"), nie jej nazwa.
GETRESPONSE_API_KEY=
GETRESPONSE_LIST_ID=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile: sekret do weryfikacji tokenow w api/. Pusty = captcha wylaczona.
TURNSTILE_SECRET_KEY=

# Formularz kontaktowy przez Gmail API (api/contact.js), zakres gmail.send.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
CONTACT_RECIPIENT=biuro@fpmsk.org.pl

# Przypomnienia Slack (api/slack-reminders.js, wywolywane przez Vercel Cron)
CRON_SECRET=
SLACK_BOT_TOKEN=
SLACK_LIST_ID=
SLACK_LIST_URL=
SLACK_STATUS_COL=
SLACK_ASSIGNEE_COL=
SLACK_TITLE_COL=
