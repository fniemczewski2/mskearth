{
  "regions": ["fra1"],
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.msk.earth"
        }
      ],
      "destination": "https://msk.earth/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/donate-iframe",
      "destination": "/embed/donate"
    },
    {
      "source": "/donate-belka",
      "destination": "/embed/belka"
    },
    {
      "source": "/:lang(pl|en)/:rest*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|LinkedInBot|Slackbot|Discordbot|WhatsApp|TelegramBot|Pinterest|redditbot|Mastodon|Bluesky|Applebot|bingbot|Googlebot|DuckDuckBot|YandexBot).*"
        }
      ],
      "destination": "/api/page-meta?lang=:lang&rest=:rest*"
    },
    {
      "source": "/:lang(pl|en)",
      "destination": "/"
    },
    {
      "source": "/:lang(pl|en)/:page(aktualnosci|o-nas|miasta|fundacja|kontakt|wesprzyj|dziekujemy)",
      "destination": "/"
    },
    {
      "source": "/:lang(pl|en)/aktualnosci/:id",
      "destination": "/"
    },
    {
      "source": "/:lang(pl|en)/ankieta/:slug",
      "destination": "/"
    },
    {
      "source": "/:page(aktualnosci|o-nas|miasta|fundacja|kontakt|wesprzyj|dziekujemy)",
      "destination": "/"
    },
    {
      "source": "/aktualnosci/:id",
      "destination": "/"
    },
    {
      "source": "/ankieta/:slug",
      "destination": "/"
    },
    {
      "source": "/admin/:path*",
      "destination": "/"
    },
    {
      "source": "/admin",
      "destination": "/"
    }
  ],
  "crons": [
    {
      "path": "/api/slack-reminders",
      "schedule": "0 10 * * 1"
    }
  ],
  "headers": [
    {
      "source": "/((?!embed/|donate-iframe|donate-belka).*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), browsing-topics=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://challenges.cloudflare.com https://www.googletagmanager.com; style-src 'self'; style-src-attr 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https://*.supabase.co https://*.google-analytics.com https://www.googletagmanager.com; media-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.climateclock.world https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; frame-src https://checkout.stripe.com https://challenges.cloudflare.com; frame-ancestors 'self' https://fpmsk.org.pl https://www.fpmsk.org.pl; form-action 'self' https://checkout.stripe.com; base-uri 'none'; object-src 'none'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/(embed/.*|donate-iframe.*|donate-belka.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), browsing-topics=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://challenges.cloudflare.com https://www.googletagmanager.com; style-src 'self'; style-src-attr 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https://*.supabase.co https://*.google-analytics.com https://www.googletagmanager.com; media-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.climateclock.world https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; frame-src https://checkout.stripe.com https://challenges.cloudflare.com; frame-ancestors 'self' https:; form-action 'self' https://checkout.stripe.com; base-uri 'none'; object-src 'none'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/(pl|en)/(ankieta/.*|dziekujemy)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(admin.*|api/.*|embed/.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(assets|fonts|icons)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/locales/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|webp|ico|webm|pdf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "functions": {
    "api/page-meta.js": {
      "includeFiles": "public/locales/*.json"
    }
  }
}
