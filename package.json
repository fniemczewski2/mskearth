{
  "name": "mskearth",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "postbuild": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/generate-sitemap.mjs",
    "remind-tasks": "python scripts/tasks-reminder.py",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons": "python scripts/build-icons.py",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --dry-run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.18",
    "luxon": "^3.7.1",
    "prop-types": "^15.8.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.18.2",
    "stripe": "^22.5.0",
    "uuid": "^14.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@vitejs/plugin-react": "^6.0.5",
    "bootstrap-icons": "^1.13.1",
    "eslint": "^9.33.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.10.1",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
